# OpenProject Configuration
OPENPROJECT_BASE_URL=https://project.intermesh.net
OPENPROJECT_API_KEY=your_openproject_api_key_here

# LLM Provider — set one of the keys below and set LLM_PROVIDER accordingly
# Recommended: Claude (best reasoning for project/member matching)
# Get API key from https://console.anthropic.com (separate from claude.ai subscription)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Alternative: Groq — free, works from India: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Alternative: Gemini (may be blocked in India): https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# LLM_PROVIDER: "claude" | "groq" | "gemini"
LLM_PROVIDER=groq

# Google Apps Script — for Chat DM + Gmail notifications after ticket creation
# Steps to get this URL: see apps_script/Code.gs for setup instructions
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
EMAIL_DOMAIN=indiamart.com

# Server Configuration
PORT=8000
HOST=0.0.0.0
